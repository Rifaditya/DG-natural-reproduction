  "authors": [
    "Dasik (Rifaditya)"
  ],
  "contact": {
    "homepage": "https://github.com/Dasik/Natural-Reproduction",
    "sources": "https://github.com/Dasik/Natural-Reproduction"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/natural-reproduction/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.vanillaoutsider.naturalreproduction.NaturalReproductionFabric"
    ],
    "modmenu": [
      "net.vanillaoutsider.naturalreproduction.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "natural-reproduction.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.1",
    "minecraft": ">=26.2-",
    "java": ">=25",
    "fabric-api": "*",
